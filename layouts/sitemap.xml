{{- /*
  Explicit sitemap template.

  Hugo's built-in sitemap ranges over the home page's `.Pages`, which is only
  the top-level sections — it drops the home page itself and every Writing
  post once `[outputs]` is customised in hugo.toml. Ranging over `site.Pages`
  here covers home, the sections, and all regular pages regardless of the
  output-format configuration.

  Set `sitemap.disable = true` in a page's front matter to omit it.
*/ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range site.Pages }}
  {{- if and .Permalink (ne .Sitemap.Disable true) }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
    {{- end }}
    {{- with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>
    {{- end }}
    {{- if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>
    {{- end }}
  </url>
  {{- end }}
  {{- end }}
</urlset>
